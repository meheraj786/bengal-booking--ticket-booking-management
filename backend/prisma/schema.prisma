generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String     @id @default(uuid())
  name                  String
  email                 String     @unique
  passwordHash          String?
  isVerified            Boolean    @default(false)
  verificationToken     String?    @unique
  verificationExpiresAt DateTime?
  phone                 String?
  role                  Role       @default(USER)
  status                UserStatus @default(ACTIVE)
  image                 String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  events                Event[]    @relation("SellerEvents")
  bookings              Booking[]
}

model Division {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  areas     Area[]
}

model Area {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  divisionId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  events     Event[]

  @@unique([divisionId, slug])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  image       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  events      Event[]
}

model Event {
  id                   String      @id @default(uuid())
  sellerId             String
  categoryId           String
  areaId               String
  title                String
  description          String
  venueName            String
  venueAddress         String
  startAt              DateTime
  endAt                DateTime
  maxTicketsPerBooking Int         @default(5)
  lastDateAndTimeOfCancel DateTime?
  lastDateOfBooking       DateTime?
  paymentType             PaymentType @default(Free)
  status               EventStatus @default(DRAFT)
  coverImage           String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  seller               User        @relation("SellerEvents", fields: [sellerId], references: [id])
  category             Category    @relation(fields: [categoryId], references: [id])
  area                 Area        @relation(fields: [areaId], references: [id])
  bookings             Booking[]
  tickets              Ticket[]

  @@index([status, startAt])
}

model Ticket {
  id           String       @id @default(uuid())
  eventId      String
  status       TicketStatus @default(AVAILABLE)
  bookingId    String?
  createdAt    DateTime     @default(now())
  note         String?
  updatedAt    DateTime     @updatedAt
  event        Event        @relation(fields: [eventId], references: [id])
  booking      Booking?     @relation(fields: [bookingId], references: [id])

  @@index([eventId, status])
}

model Booking {
  id          String        @id @default(uuid())
  userId      String
  eventId     String
  quantity    Int
  totalAmount Decimal       @db.Decimal(12, 2)
  buyerName   String
  buyerAddress String
  buyerPhone  String
  status      BookingStatus @default(PENDING)
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id])
  event       Event         @relation(fields: [eventId], references: [id])
  tickets     Ticket[]
  payment     Payment?

  @@index([userId, status])
  @@index([expiresAt, status])
}

model Payment {
  id                String        @id @default(uuid())
  bookingId         String        @unique
  amount            Decimal       @db.Decimal(12, 2)
  provider          String        @default("sslcommerz")
  providerPaymentId String?
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  booking           Booking       @relation(fields: [bookingId], references: [id])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum TicketStatus {
  AVAILABLE
  LOCKED
  SOLD
  CANCELLED
}

enum Role {
  SUPER_ADMIN
  SELLER
  USER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum PaymentType {
  Advance
  OnArrival
  Free
}
